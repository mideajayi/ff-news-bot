# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ForexFactory export feed
FF_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Digest schedule (24h, local to TIMEZONE below)
DIGEST_HOUR=6
DIGEST_MINUTE=0
TIMEZONE=Africa/Lagos

# Real-time poll interval (minutes) — keep >= 5 to respect FF's rate limit (2 req/5min)
POLL_INTERVAL_MINUTES=5

# Which impact levels trigger real-time alerts: comma separated: high,medium,low
ALERT_IMPACT_LEVELS=high,medium,low
